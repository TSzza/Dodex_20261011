*.png                binary
*.PNG                binary
*.jpg                binary
*.jpeg               binary
*.gif                binary
*.bmp                binary
*.tga                binary
*.tif                binary
*.tiff               binary
*.psd                binary
*.exr                binary
*.hdr                binary
*.dds                binary
*.ktx                binary
*.ktx2               binary
*.astc               binary
*.pvr                binary
*.iff                binary
*.pict               binary

# ---------- 音频 ----------
*.wav                binary
*.mp3                binary
*.ogg                binary
*.aiff               binary
*.m4a                binary
*.flac               binary

# ---------- 视频 ----------
*.mp4                binary
*.mov                binary
*.webm               binary
